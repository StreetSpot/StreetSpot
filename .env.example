# StreetSpot environment contract — names only, never commit secrets
# Required for durable vendor discovery and account-backed features. Use the same active Supabase project for these values.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Legacy anon JWT used as the Authorization bearer for public PostgREST reads when no user token is present.
SUPABASE_ANON_KEY=
# Server-only Supabase service key for trusted webhook/database operations. NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Optional public aliases for client-side Supabase SDK use; safe to expose, but do not put secret/service-role keys here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional only if a free map provider is explicitly configured.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional server-side Stripe API key only if server-created Checkout Sessions are implemented.
STRIPE_SECRET_KEY=
# Required for the StreetSpot Stripe webhook endpoint after it is created in Stripe Dashboard/API.
STRIPE_WEBHOOK_SECRET=
# Server-only shared secret for the protected entitlement-sync RPC. Use a long random value.
STREETSPOT_STRIPE_SYNC_SECRET=
GOOGLE_MAPS_API_KEY=
STREETSPOT_AGENT_ACCESS_PASSWORD=replace-with-a-long-random-password-at-least-24-characters
AI_GATEWAY_API_KEY=
# Optional AI Gateway model override; default is openai/gpt-5.6-sol
STREETSPOT_AI_MODEL=openai/gpt-5.6-sol
# Stripe Checkout Session test-only integration. Keep secret keys server-side.
STRIPE_PRICE_VENDOR_BRONZE=
STRIPE_PRICE_VENDOR_SILVER=
STRIPE_PRICE_VENDOR_GOLD=
STRIPE_PRICE_THEME_STREET_STYLE=
STRIPE_PRICE_THEME_CREATOR=
STRIPE_PRICE_THEME_BRAND_STUDIO=
NEXT_PUBLIC_SITE_URL=https://streetspotapp.com
