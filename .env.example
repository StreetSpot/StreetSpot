# StreetSpot environment contract — names only, never commit secrets
# REQUIRED: none for the current free-first build
# OPTIONAL/FUTURE: configure only with server-side authorization and RLS
# PAID/DISABLED: Stripe, paid maps, and AI remain disabled unless explicitly approved and configured.
# Prefer SUPABASE_URL for server-side API routes. NEXT_PUBLIC_SUPABASE_URL is a compatibility fallback only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# OPTIONAL: only used when a free map provider is explicitly configured
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-only service role key. Never expose this with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=
# FUTURE/PAID-DISABLED: do not enable without an approved free-tier plan
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
GOOGLE_MAPS_API_KEY=
STREETSPOT_AGENT_ACCESS_PASSWORD=replace-with-a-long-random-password-at-least-24-characters
AI_GATEWAY_API_KEY=
# Optional AI Gateway model override; default is openai/gpt-5.6-sol
STREETSPOT_AI_MODEL=openai/gpt-5.6-sol
